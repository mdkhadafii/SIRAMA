# URL publik setelah domain deployment ditentukan (untuk metadata, sitemap, dan robots).
NEXT_PUBLIC_SITE_URL=

# Koneksi Supabase untuk konten publik dan sesi admin.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only untuk pembatasan percobaan login. Jangan gunakan pada browser.
SUPABASE_SECRET_KEY=

# Nomor WhatsApp resmi Indonesia: awalan 62, tanpa tanda plus atau nol awal.
# Kosongkan sampai nomor pengelola dikonfirmasi.
WHATSAPP_OFFICIAL_NUMBER=
